PROJECT_NAME=岭潮共创
ENVIRONMENT=demo
DEBUG=false
API_V1_PREFIX=/api/v1

MYSQL_DATABASE=lingchao_demo
MYSQL_USER=lingchao_demo
MYSQL_PASSWORD=LingchaoDemoDb2026
MYSQL_ROOT_PASSWORD=LingchaoDemoRoot2026

# The launcher replaces this marker with a locally generated random secret.
JWT_SECRET_KEY=__GENERATE_RANDOM_JWT_SECRET__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

ADMIN_USERNAME=admin
ADMIN_PASSWORD=DemoAdmin123!
SMS_MODE=demo
SMS_CODE_EXPIRE_SECONDS=300
SMS_RETRY_AFTER_SECONDS=60

# Offline-safe providers: no third-party credentials are bundled.
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
IMAGE_GENERATOR_PROVIDER=mock
ZHIPU_API_KEY=

VITE_API_BASE_URL=/api/v1
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
