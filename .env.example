PROJECT_NAME=岭潮共创
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
MYSQL_DATABASE=lingchao
MYSQL_USER=lingchao
MYSQL_PASSWORD=lingchao_dev
MYSQL_ROOT_PASSWORD=root_dev_only
DATABASE_URL=mysql+asyncmy://lingchao:lingchao_dev@mysql:3306/lingchao?charset=utf8mb4
JWT_SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# AI text generation
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TIMEOUT_SECONDS=30

# AI image generation
IMAGE_GENERATOR_PROVIDER=mock
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_IMAGE_MODEL=cogview-4-250304
ZHIPU_IMAGE_SIZE=768x1344
ZHIPU_IMAGE_QUALITY=standard
ZHIPU_IMAGE_WATERMARK_ENABLED=true
ZHIPU_IMAGE_TIMEOUT_SECONDS=90
ZHIPU_IMAGE_MAX_RETRIES=2
ZHIPU_IMAGE_RETRY_DELAY_SECONDS=1

# Embedding and RAG
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=work/model-cache
RAG_KNOWLEDGE_DIR=data/knowledge_base
RAG_PROMPT_PATH=data/prompts/rag_chat.txt
IMAGE_PROMPT_PATH=data/prompts/image_prompt.txt
RAG_VECTOR_STORE_DIR=work/chroma
RAG_COLLECTION_NAME=lingnan_knowledge
RAG_TOP_K=5
RAG_MIN_SCORE=0.45

VITE_API_BASE_URL=/api/v1
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
